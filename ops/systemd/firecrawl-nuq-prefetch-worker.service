[Unit]
Description=Firecrawl NUQ prefetch worker
After=network.target dragonfly.service nats.service postgresql@16-main.service
Wants=dragonfly.service nats.service postgresql@16-main.service

[Service]
Type=simple
User=x
Group=x
WorkingDirectory=/adapt/repos/firecrawl/apps/api
Environment=HOME=/home/x
Environment=NUQ_POD_NAME=nuq-prefetch-worker-0
Environment=NUQ_PREFETCH_REPLICAS=1
Environment=NUQ_PREFETCH_WORKER_PORT=3011
EnvironmentFile=/etc/firecrawl/firecrawl.env
ExecStart=/usr/bin/node dist/src/services/worker/nuq-prefetch-worker.js
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=firecrawl.target

