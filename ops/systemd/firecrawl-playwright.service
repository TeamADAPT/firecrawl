[Unit]
Description=Firecrawl Playwright rendering service
After=network.target

[Service]
Type=simple
User=x
Group=x
WorkingDirectory=/adapt/repos/firecrawl/apps/playwright-service-ts
Environment=HOME=/home/x
Environment=PLAYWRIGHT_BROWSERS_PATH=/home/x/.cache/ms-playwright
EnvironmentFile=/etc/firecrawl/playwright.env
ExecStart=/usr/bin/node dist/api.js
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=firecrawl.target

