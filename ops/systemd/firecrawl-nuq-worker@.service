[Unit]
Description=Firecrawl NUQ worker %i
After=network.target dragonfly.service nats.service postgresql@16-main.service
Wants=dragonfly.service nats.service postgresql@16-main.service

[Service]
Type=simple
User=x
Group=x
WorkingDirectory=/adapt/repos/firecrawl/apps/api
Environment=HOME=/home/x
EnvironmentFile=/etc/firecrawl/firecrawl.env
ExecStart=/bin/bash -lc 'export NUQ_WORKER_PORT=$((3006 + %i)); export NUQ_POD_NAME=nuq-worker-%i; exec /usr/bin/node dist/src/services/worker/nuq-worker.js'
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=firecrawl.target

