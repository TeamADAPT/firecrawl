[Unit]
Description=Firecrawl queue worker
After=network.target dragonfly.service nats.service postgresql@16-main.service firecrawl-api.service
Wants=dragonfly.service nats.service postgresql@16-main.service

[Service]
Type=simple
User=x
Group=x
WorkingDirectory=/adapt/repos/firecrawl/apps/api
Environment=HOME=/home/x
Environment=NUQ_POD_NAME=worker
Environment=WORKER_PORT=3005
EnvironmentFile=/etc/firecrawl/firecrawl.env
ExecStart=/usr/bin/node dist/src/services/queue-worker.js
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=firecrawl.target

