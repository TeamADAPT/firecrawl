[Unit]
Description=Firecrawl NUQ reconciler worker
After=network.target dragonfly.service rabbitmq-server.service postgresql@16-main.service
Wants=dragonfly.service rabbitmq-server.service postgresql@16-main.service

[Service]
Type=simple
User=x
Group=x
WorkingDirectory=/adapt/repos/firecrawl/apps/api
Environment=HOME=/home/x
Environment=NUQ_POD_NAME=nuq-reconciler-worker-0
Environment=NUQ_RECONCILER_WORKER_PORT=3012
EnvironmentFile=/etc/firecrawl/firecrawl.env
ExecStart=/usr/bin/node dist/src/services/worker/nuq-reconciler-worker.js
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=firecrawl.target

