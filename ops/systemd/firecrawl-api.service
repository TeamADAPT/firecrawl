[Unit]
Description=Firecrawl API service
After=network.target dragonfly.service rabbitmq-server.service postgresql@16-main.service firecrawl-playwright.service
Wants=dragonfly.service rabbitmq-server.service postgresql@16-main.service firecrawl-playwright.service

[Service]
Type=simple
User=x
Group=x
WorkingDirectory=/adapt/repos/firecrawl/apps/api
Environment=HOME=/home/x
EnvironmentFile=/etc/firecrawl/firecrawl.env
ExecStart=/usr/bin/node dist/src/index.js
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=firecrawl.target

